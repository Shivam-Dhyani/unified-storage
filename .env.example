# Integration test configuration for scripts/integration-telegram.ts and scripts/bench.ts.
# Copy to .env (git-ignored) and fill in. NEVER commit real secrets.
#
# The integration tests only run when these are set; unit tests need none of this.

# From https://my.telegram.org -> API development tools
IT_TELEGRAM_API_ID=
IT_TELEGRAM_API_HASH=

# Bot token from @BotFather
IT_TELEGRAM_BOT_TOKEN=

# A channel the bot is an admin of, as the MTProto channel id (positive, string).
# e.g. 1234567890  (NOT the Bot API -100... form)
IT_TELEGRAM_TEST_CHANNEL_ID=

# Where the bot session string is cached between runs (mode 600 recommended).
IT_TELEGRAM_SESSION_FILE=./.telegram-it.session

# --- R2 (optional; integration for the R2 adapter) ---
IT_R2_ENDPOINT=
IT_R2_ACCESS_KEY_ID=
IT_R2_SECRET_ACCESS_KEY=
IT_R2_BUCKET=

# --- bench.ts (T-INF-03): posts results to the Holocast Lab ---
LAB_TOKEN=
LAB_URL=
